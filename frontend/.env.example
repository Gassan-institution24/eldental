# ElDental frontend — environment template (Vite).
# Copy to `.env` (gitignored). Only VITE_* variables are exposed to the browser —
# NEVER put secrets here.

VITE_APP_NAME=ElDental
VITE_API_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
VITE_DEFAULT_LANG=ar
VITE_DEFAULT_TIMEZONE=Asia/Amman
VITE_DEFAULT_CURRENCY=JOD
