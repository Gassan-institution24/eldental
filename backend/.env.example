# ─────────────────────────────────────────────────────────────
# ElDental backend — environment template
# Copy to `.env` and fill in values. `.env` is gitignored.
# All variables are validated at boot by src/config/env.ts (Zod);
# the server refuses to start if a required one is missing.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=ElDental
# Public URLs (used in emails, links, CORS)
API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Serve the built frontend from this process (one origin, e.g. Railway without a domain).
# Empty = API only. Example: ../frontend/dist
FRONTEND_DIST_DIR=
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────
# Must be a replica set (transactions are used for accounting/booking)
MONGODB_URI=mongodb://127.0.0.1:27017/eldental?replicaSet=rs0&directConnection=true

# ── Redis (BullMQ jobs, rate limiting, permission cache) ─────
REDIS_URL=redis://127.0.0.1:6379

# ── Auth ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=eld_rt
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
BCRYPT_COST=12
OTP_TTL_MINUTES=10
# Used to encrypt sensitive fields at rest (e.g. JoFotara secrets) — 32 bytes hex
FIELD_ENCRYPTION_KEY=change-me-64-hex-chars

# ── Seed (first superadmin, created by `npm run seed`) ───────
SEED_SUPERADMIN_EMAIL=superadmin@eldental.local
SEED_SUPERADMIN_PASSWORD=ChangeMe!12345

# ── Localisation defaults ────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Amman
DEFAULT_CURRENCY=JOD
DEFAULT_LOCALE=ar
DEFAULT_COUNTRY_CODE=962

# ── Email (SMTP) — dev uses Mailpit from docker-compose ──────
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ElDental <no-reply@eldental.local>"

# ── WhatsApp (Mazbot) ────────────────────────────────────────
# NO credentials in env files. The superadmin enters the WhatsApp
# credentials and template ids in Admin → Settings → Integrations;
# they are stored encrypted (FIELD_ENCRYPTION_KEY) in platformSettings.

# ── File storage ─────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
# Only when STORAGE_DRIVER=s3 (works with AWS S3, Cloudflare R2, MinIO)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300

# ── JoFotara (Jordan e-invoicing) ────────────────────────────
JOFOTARA_ENABLED=false
JOFOTARA_BASE_URL=https://backend.jofotara.gov.jo/core/invoices/
# Per-clinic credentials (client id / secret / activity number) are stored
# encrypted on the Clinic document, not here.

# ── Rate limits ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
